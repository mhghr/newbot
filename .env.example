BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321
CHANNEL_ID=-1001234567890
CHANNEL_URL=https://t.me/your_channel
DATABASE_URL=postgresql://postgres:123@localhost:5432/newbot
PROXY_URL=https://127.0.0.1:3067

# ArvanCloud API key with DNS access, for automatic WireGuard endpoint failover.
# The domain is read from the routers' wg_endpoint; set DNS_FAILOVER_DOMAIN only
# to override it explicitly.
ARVAN_API_KEY=
ARVAN_API_BASE=https://napi.arvancloud.ir/cdn/4.0
DNS_FAILOVER_TTL=120
DNS_FAILOVER_INTERVAL=120
DNS_FAILOVER_ENABLED=1
# Quality thresholds: switch when the active router is unhealthy, or is
# "degraded" (loss/rtt above these) while another router is clearly better.
DNS_FAILOVER_HANDSHAKE_MAX=180
DNS_FAILOVER_LOSS_DEGRADED=15
DNS_FAILOVER_RTT_DEGRADED=300
DNS_FAILOVER_LOSS_UNHEALTHY=40

# Telethon userbot for the proxy relay (reads source channels the bot is not in)
# Get api_id/api_hash from https://my.telegram.org -> API development tools.
TG_API_ID=123456
TG_API_HASH=your_api_hash_here
TG_PHONE=+98912xxxxxxx
TG_SESSION=proxy_userbot
# Comma-separated source channels: @username, -1001234567890 or invite links
PROXY_SOURCE_CHANNELS=@source_channel_one,@source_channel_two
